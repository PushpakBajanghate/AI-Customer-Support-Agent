# ==================================================
# Environment Configuration Template
# Copy this file to .env and fill in your values
# ==================================================

# LLM Provider Configuration (Google Gemini default)
LLM_PROVIDER=gemini
LLM_API_KEY=your_google_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
LLM_FAST_MODEL=
LLM_DIRECT_CONNECTION=false
LLM_NO_PROXY_HOSTS=generativelanguage.googleapis.com,googleapis.com
# Note: GEMINI_API_KEY or GOOGLE_API_KEY are also automatically detected

# Database Configuration (PostgreSQL source of truth)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/customer_support_db

# Vector Database Configuration (Qdrant for RAG)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=support_knowledge
RAG_EMBEDDING_MODEL=models/embedding-001
RAG_VECTOR_ENABLED=false
RAG_VECTOR_TIMEOUT_SECONDS=3

# Authentication Configuration (JWT)
JWT_SECRET_KEY=change_this_secret_key_in_production_min_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application Configuration
APP_ENV=development
API_PORT=8000
API_HOST=0.0.0.0
