# ==================================================
# Environment Configuration Template
# Copy this file to .env and fill in your values
# ==================================================

# LLM Provider Configuration
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# Database Configuration (PostgreSQL source of truth)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/customer_support_db

# Vector Database Configuration (Qdrant for RAG)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Authentication Configuration (JWT)
JWT_SECRET_KEY=change_this_secret_key_in_production_min_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application Configuration
APP_ENV=development
API_PORT=8000
API_HOST=0.0.0.0
